---
import Logo from './Logo.astro';
import { POLICIES, SECTION_INFO, SITE, type DocSection } from '../lib/site';

const year = new Date().getFullYear();
const docLinks: DocSection[] = ['Get started', 'Concepts', 'Build agents', 'API server', 'TypeScript client', 'Reference', 'Troubleshooting', 'Glossary', 'Compare'];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo />
      <p>Open-source Python framework for production multi-agent AI, with the production server included.</p>
      <a class="footer-version" href="/changelog">v{SITE.version} <span>Changelog</span></a>
    </div>
    <nav aria-label="Docs">
      <h2>Docs</h2>
      <ul>
        {docLinks.map((s) => <li><a href={`/docs/${SECTION_INFO[s].slug}`}>{s}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Community">
      <h2>Community</h2>
      <ul>
        <li><a href="/docs/project">About the project</a></li>
        <li><a href={SITE.playground}>Playground</a></li>
        <li><a href="/maintainers">Maintainers</a></li>
        <li><a href={`${SITE.github}/issues`}>Issues</a></li>
        {POLICIES.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="AI and feeds">
      <h2>AI and feeds</h2>
      <ul>
        <li><a href="/llms.txt">llms.txt</a></li>
        <li><a href="/llms-full.txt">llms-full.txt</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <span>&copy; {year} <a href={SITE.org.url}>{SITE.org.name}</a>. {SITE.name} is open source under the MIT license.</span>
    <span>Formerly {SITE.formerName}</span>
  </div>
</footer>
