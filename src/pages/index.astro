---
// Homepage. Ported from design/10xgraph/v7-journey.html (the approved prototype). Styles live in
// src/styles/home.css, scoped to .home. This file is now the source of truth for the homepage;
// edit it here, not in the design prototype.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import '../styles/home.css';

// One definition sentence, reused in the first FAQ answer, the JSON-LD and the visible definition.
const definition = "10xGraph is open-source, self-hosted infrastructure for AI applications. You write the agents, tools and tasks; 10xGraph runs them behind an API server with authentication, role-based access, tenant isolation, durable state in Postgres and Redis, background jobs, metrics and tracing, and generates Docker and Kubernetes deploy files. MIT licensed, by 10xScale. Formerly Agentflow.";
const title = "10xGraph: Open-Source Infrastructure for AI Applications";
const description = "Open-source, self-hosted infrastructure for AI applications. Write the agents, tools and tasks; 10xGraph runs the API server, auth, tenant isolation, state, jobs, metrics and deploy files.";
// Single source for the visible FAQ and the FAQPage JSON-LD, so the two never drift apart.
// Backticks mark inline code: rendered as <code> on the page, stripped in the JSON-LD text.
const faq = [
  {
    q: "What is 10xGraph?",
    a: definition
  },
  {
    q: "What do I write, and what does 10xGraph run for me?",
    a: "You write the agents, tools, tasks and prompts in Python. 10xGraph runs the API server, authentication, roles and tenant isolation, durable state, background jobs, metrics, tracing and the audit log, and writes the Docker and Kubernetes files."
  },
  {
    q: "Is it only for agents?",
    a: "Agents are the main workload, and the graph engine is part of the install. Background jobs run any Python task on a worker with the same identity and access rules."
  },
  {
    q: "How does it keep tenants apart?",
    a: "Your auth class verifies the token. Roles give permissions and a reach of own, tenant or all. Tenant columns on the checkpointer and store are filled from the verified identity, and every query filters by them. A thread from another tenant answers 404. Row-level security in Postgres is opt-in."
  },
  {
    q: "Do I have to use Postgres?",
    a: "No. Postgres and Redis are the defaults, SQLite works for local development, and each storage layer is an interface you can implement for the database you run: `BaseCheckpointer` for threads, `BaseStore` for memory and `BaseCacheStore` for shared server state."
  },
  {
    q: "Does 10xGraph help with SOC 2 or ISO 27001?",
    a: "10xGraph is software you run, so it holds no certification itself; your organization and deployment are what get audited. The control mapping shows which controls its features support, such as access control, rate limiting and the audit log, and which stay yours, such as encryption at rest and backups."
  },
  {
    q: "Can it run background jobs?",
    a: "Yes. Tasks are TaskIQ tasks run by `10xgraph worker`, with `10xgraph scheduler` for cron schedules, on Redis Streams, RabbitMQ or Kafka. A task runs as the user who queued it."
  },
  {
    q: "What happens if the server crashes mid-run?",
    a: "With a checkpointer configured, 10xGraph records the current node before running it and keeps a ledger of every completed tool call. When the run resumes, on the same process or a new pod, the interrupted node runs again, but any tool call already in the ledger is skipped instead of executed. A payment tool that finished before the crash does not charge the card a second time."
  },
  {
    q: "How does my frontend talk to the server?",
    a: "Through the typed TypeScript client, installed with npm install 10xgraph-client. It covers invoke, streaming, threads, memory and file uploads, and it sends the same JWT the server checks. It works in Next.js, Vite and Node. Tools can also run in the browser, for work only the user's device can do."
  },
  {
    q: "Do I need LangChain?",
    a: "No. 10xGraph has no LangChain dependency."
  },
  {
    q: "Which models does it support?",
    a: "OpenAI, Google Gemini (including Vertex AI) and Anthropic (direct API, Vertex AI and Amazon Bedrock), plus any OpenAI-compatible endpoint such as Ollama or vLLM."
  },
  {
    q: "Who uses 10xGraph in production?",
    a: "Zilogue, an AI interview platform for hiring teams built by 10xScale, runs on 10xGraph in production. 10xScale builds and maintains 10xGraph."
  },
  {
    q: "Was 10xGraph previously called Agentflow?",
    a: "Yes. 10xGraph was published as Agentflow, under the PyPI name 10xscale-agentflow, until 2026. The project was renamed because many unrelated tools share the Agentflow name. The Python package is now imported as tenxgraph. The old agentflow import path remains as a deprecated alias until 2.0, so existing code keeps working while you switch to the new package names."
  }
];
const plain = (s: string) => s.replaceAll('`', '');
const parts = (s: string) => s.split('`');
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "10xScale",
    "url": "https://10xscale.ai/"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "10xGraph",
    "url": "https://10xgraph.com/"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "10xGraph",
    "alternateName": "Agentflow",
    "description": definition,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS, Windows",
    "softwareVersion": SITE.version,
    "programmingLanguage": "Python",
    "license": "https://opensource.org/licenses/MIT",
    "url": "https://10xgraph.com/",
    "image": "https://10xgraph.com/logo-512.png",
    "codeRepository": "https://github.com/10xGraph/10xGraph",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "publisher": {
      "@type": "Organization",
      "name": "10xScale"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": plain(f.a) }
    }))
  }
];
---
<BaseLayout title={title} description={description} exactTitle jsonLd={jsonLd}>
<div class="home">
<!-- 1. HERO -->
<section class="hero" aria-labelledby="h1">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Open source · MIT · Self-hosted · Python 3.12+</p>
        <h1 id="h1">Write your AI logic. 10xGraph runs <span class="hl">the infrastructure</span>.</h1>
        <p class="sub">The open-source backend for AI products you ship to your own customers. Auth, roles, tenant isolation, durable state, background jobs, metrics and an audit log come with the install. One command writes your Docker and Kubernetes files.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/docs/get-started/first-agent">Build your first app <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <button class="pill" type="button" data-copy="pip install 10xgraph 10xgraph-api"><span class="prompt" aria-hidden="true">$</span><code>pip install 10xgraph 10xgraph-api</code><span class="cp" aria-live="polite">Copy</span></button>
        </div>
        <a class="link star" href="https://github.com/10xGraph/10xGraph">Star on GitHub</a>
      </div>

      <div class="stage" id="stage" role="region" aria-label="Animation: your code unfolds into a running AI infrastructure">
        <p class="sr-only">An editor types a short agent.py and a 10xgraph.json with JWT authentication that reads the tenant from the org_id claim, a Redis cache store, a Redis stream worker broker and the audit log turned on. The editor tilts into an isometric base, and the infrastructure rises on top of it in layers: validators for prompt injection, rate limits shared through Redis, access with roles and a reach of own, tenant or all, authentication with JWT or your own class, and the API server on port 8000. PostgreSQL, Redis and Kubernetes pods, including a worker pod, slide in beside it. Requests from a TypeScript client travel down through the layers and a request log lists each one: an expired token gets 401 EXPIRED_TOKEN, a thread in another tenant gets 404, a burst gets 429 with a retry-after of 12 seconds, a prompt injection gets 422 prompt injection blocked, and a report task gets 202 task make_report queued. When a pod is lost mid-refund, a new pod resumes and the refund is skipped because it is already in the ledger. The traffic is illustrative.</p>
        <div class="iso">
          <div class="iso-head" aria-hidden="true">
            <span class="iso-live"><i></i><b id="phase">writing agent.py</b></span>
            <span class="iso-legend"><span><i class="k-you"></i>you write</span><span><i class="k-gen"></i>10xGraph generates</span><span><i class="k-inf"></i>your infra</span></span>
          </div>
          <div class="iso-scene" id="scene" aria-hidden="true">
            <div class="iso-tilt" id="tilt">
              <svg id="iso-svg" viewBox="0 0 640 430">
                <g class="iso-grid" id="iso-grid"></g>
                <g id="iso-world"></g>
                <g id="iso-labels"></g>
                <g id="iso-fx"></g>
              </svg>
            </div>
            <div class="iso-ed" id="iso-ed">
              <div class="iso-ed-tabs"><span id="iso-tab1" class="on">agent.py</span><span id="iso-tab2">10xgraph.json</span></div>
              <pre id="iso-pre"></pre>
            </div>
          </div>
          <div class="iso-log" aria-hidden="true"><ol id="iso-log"></ol></div>
          <div class="iso-foot">
            <div class="cmdl" aria-hidden="true"><span>$</span> <code id="iso-cmd"></code><i class="caret"></i></div>
            <span class="tag-ill">illustrative traffic</span>
            <button class="ctl" id="iso-ctl" type="button" aria-pressed="false"><svg class="i-pause" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1.5v7M7.5 1.5v7" stroke="currentColor" stroke-width="1.8"/></svg><svg class="i-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1.2l6 3.8-6 3.8z" fill="currentColor"/></svg><span class="ctl-t">Pause</span></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- 2. PROOF LINE -->
<div class="strip">
  <div class="wrap">
    <p class="proof"><span><a href="#in-production">Runs Zilogue in production</a></span><span>MIT licensed</span><span>Self-hosted on your infrastructure</span><span>OpenAI, Anthropic, Gemini, Vertex AI, Bedrock and any MCP server</span></p>
  </div>
</div>
<!-- 2. CHAPTER 01 -->
<section class="ch" id="problem" aria-labelledby="what">
  <div class="wrap">
    <p class="chap"><span class="chap-n">01</span> <span>The problem</span></p>
    <div class="g12 statement">
      <div class="st-main">
        <h2 id="what" class="label">What is 10xGraph?</h2>
              <p class="def">10xGraph is open-source, self-hosted infrastructure for AI applications. You write the agents, tools and tasks; 10xGraph runs them behind an API server with authentication, role-based access, tenant isolation, durable state in Postgres and Redis, background jobs, metrics and tracing, and generates Docker and Kubernetes deploy files. MIT licensed, by 10xScale. Formerly Agentflow.</p>
      </div>
      <dl class="facts">
      <div><dt>License</dt><dd>MIT</dd></div>
      <div><dt>Runtime</dt><dd>Python 3.12+</dd></div>
      <div><dt>Status</dt><dd>1.0 release candidate</dd></div>
      <div><dt>Updated</dt><dd>November 2026</dd></div>
      </dl>
    </div>
    <div class="cmp-block">
      <h2 id="cmp-h">The backend you do not have to write</h2>
      <p class="lede">Most agent frameworks stop at the graph. Shipping it to customers means building this layer yourself or buying a hosted platform.</p>
    <table class="cmp">
      <thead><tr><th scope="col">Without 10xGraph, you build</th><th scope="col">With 10xGraph</th></tr></thead>
      <tbody>
        <tr><td data-label="Without 10xGraph, you build">An API server with streaming and WebSockets</td><td data-label="With 10xGraph">Generated from your graph</td></tr>
        <tr><td data-label="Without 10xGraph, you build">Login, roles and per-customer data isolation</td><td data-label="With 10xGraph">One <code>auth</code> block in 10xgraph.json</td></tr>
        <tr><td data-label="Without 10xGraph, you build">Thread storage, caching and long-term memory</td><td data-label="With 10xGraph">Postgres and Redis built in, any database pluggable</td></tr>
        <tr><td data-label="Without 10xGraph, you build">A job queue, worker and scheduler</td><td data-label="With 10xGraph"><code>10xgraph worker</code> and <code>10xgraph scheduler</code></td></tr>
        <tr><td data-label="Without 10xGraph, you build">Metrics, tracing and access logs</td><td data-label="With 10xGraph">Prometheus, OpenTelemetry, JSON logs, audit log</td></tr>
        <tr><td data-label="Without 10xGraph, you build">Dockerfiles and Kubernetes manifests</td><td data-label="With 10xGraph"><code>10xgraph build</code></td></tr>
      </tbody>
    </table>
    </div>
  </div>
</section>
<!-- 3. CHAPTER 02 -->
<section class="ch" id="journey" aria-labelledby="journey-h">
  <div class="wrap">
    <p class="chap"><span class="chap-n">02</span> <span>Follow one request</span></p>
    <div class="g12 ch-head">
      <h2 id="journey-h">Follow one request through 10xGraph</h2>
      <p class="lede">One call from your app, through every layer it passes on the way to an answer. You write the agent. The rest is the install.</p>
    </div>
    <div class="journey" id="journey-body">
      <div class="railbar" aria-hidden="true"><div class="railbar-t" id="railbar-t">Step 1 of 7 &middot; Your app calls</div><div class="railbar-p"><span class="railbar-f" id="railbar-f"></span></div></div>
      <nav class="rail" aria-label="Steps">
        <div class="rail-in">
        <div class="steps-wrap"><span class="rail-fill" id="rail-fill" aria-hidden="true"></span>
        <ol class="steps" id="steps">
          <li><a href="#step-1"><span class="st-n">1</span><span class="st-l">Your app calls</span></a></li>
          <li><a href="#step-2"><span class="st-n">2</span><span class="st-l">Caller verified and scoped</span></a></li>
          <li><a href="#step-3"><span class="st-n">3</span><span class="st-l">The agent runs</span></a></li>
          <li><a href="#step-4"><span class="st-n">4</span><span class="st-l">State is saved</span></a></li>
          <li><a href="#step-5"><span class="st-n">5</span><span class="st-l">Long work moves to a worker</span></a></li>
          <li><a href="#step-6"><span class="st-n">6</span><span class="st-l">Every step is observed</span></a></li>
          <li><a href="#step-7"><span class="st-n">7</span><span class="st-l">It ships as files you own</span></a></li>
        </ol></div>
        </div>
      </nav>
      <div class="panels" id="panels">
      <article class="panel" id="step-1" aria-labelledby="p4h">
        <div class="panel-row"><span>Step 1 of 7</span></div>

        <h3 class="pt" id="p4h">One stack, Python backend to TypeScript frontend</h3>
        <p class="lede">An official typed TypeScript client covers invoke, streaming, threads, memory and files. Tools can run in the user's browser through remote tools.</p>
              <div class="code"><div class="cap"><span>agent.py</span><span>python</span></div><pre tabindex="0"><code><span class="k">def</span> lookup_order(order_id: str) -&gt; str:
    <span class="s">"""Look up an order by id."""</span>
    ...

agent = ReactAgent(
    model=<span class="s">"google/gemini-2.5-flash"</span>,
    system_prompt=[&#123;<span class="s">"role"</span>: <span class="s">"system"</span>, <span class="s">"content"</span>: <span class="s">"You are a support agent."</span>&#125;],
    tools=[lookup_order],
)</code></pre></div>
              <div class="code"><div class="cap"><span>app.ts</span><span>typescript</span></div><pre tabindex="0"><code><span class="k">import</span> &#123; TenxGraphClient, Message &#125; <span class="k">from</span> <span class="s">'10xgraph-client'</span>;

<span class="k">const</span> client = <span class="k">new</span> TenxGraphClient(&#123;
  baseUrl: <span class="s">'https://agents.example.com'</span>,
  authToken: userJwt,  <span class="c">// same JWT the API checks</span>
&#125;);

<span class="k">const</span> question = Message.text_message(<span class="s">'Where is order A-1042?'</span>, <span class="s">'user'</span>);

<span class="k">for await</span> (<span class="k">const</span> chunk <span class="k">of</span> client.stream([question])) &#123;
  <span class="k">if</span> (chunk.event === <span class="s">'message'</span>) render(chunk.message?.content);
&#125;</code></pre></div>
        <p class="center-link"><a href="/docs/client">TypeScript client &rarr;</a></p>
      </article>
      <article class="panel" id="step-2" aria-labelledby="p-tenancy">
        <div class="panel-row"><span>Step 2 of 7</span></div>

        <h3 class="pt" id="p-tenancy">Multi-tenant from the first request</h3>
        <p class="lede">Your customers must never see each other's data. 10xGraph checks it in storage, on every route, from the verified token.</p>
        <p class="leadin">JWT or your own auth class. Roles with permissions and a reach of own, tenant or all. Rate limits, token revocation and prompt-injection validators.</p>
        <ul class="pts c2">
        <li class="item"><h4>Tenant from the token</h4><p>Tenant columns are filled from claims your auth class verified, never from client input.</p></li>
        <li class="item"><h4>A foreign thread answers 404</h4><p>Another tenant's thread, message, memory or file is not found, so ids do not leak.</p></li>
        <li class="item"><h4>Reach per role</h4><p>Members see their own data. Admins can read across their tenant. Runs and writes stay with the caller.</p></li>
        <li class="item"><h4>Checked at boot</h4><p>The server refuses to start if a route has no permission guard or tenant claims and storage columns disagree.</p></li>
        </ul>
              <div class="code"><div class="cap"><span>10xgraph.json</span><span>json</span></div><pre tabindex="0"><code>&#123;
  <span class="s">"auth"</span>: &#123;
    <span class="s">"method"</span>: <span class="s">"jwt"</span>,
    <span class="s">"tenant_claims"</span>: [<span class="s">"org_id"</span>],
    <span class="s">"roles"</span>: &#123;
      <span class="s">"member"</span>: &#123;<span class="s">"permissions"</span>: [<span class="s">"graph:*"</span>, <span class="s">"threads:*"</span>, <span class="s">"store:*"</span>, <span class="s">"files:*"</span>], <span class="s">"reach"</span>: <span class="s">"own"</span>&#125;,
      <span class="s">"org_admin"</span>: &#123;<span class="s">"inherits"</span>: [<span class="s">"member"</span>], <span class="s">"permissions"</span>: [<span class="s">"admin:read"</span>], <span class="s">"reach"</span>: <span class="s">"tenant"</span>&#125;
    &#125;,
    <span class="s">"default_role"</span>: <span class="s">"member"</span>
  &#125;
&#125;</code></pre></div>
            <ol class="flow" aria-label="Request flow">
      <li>Token verified</li>
      <li>Roles resolved</li>
      <li>Permission checked</li>
      <li>Query filtered by tenant</li>
      <li>Foreign data: 404</li>
    </ol>
        <p class="center-link"><a href="/docs/concepts/tenancy-and-access">How tenancy and access work &rarr;</a></p>
      </article>
      <article class="panel" id="step-3" aria-labelledby="p2h">
        <div class="panel-row"><span>Step 3 of 7</span></div>
        <p class="leadin">REST, SSE streaming, WebSocket, realtime audio and AG-UI endpoints, generated from your graph.</p>
        <h3 class="pt" id="p2h">Crash mid-run. Resume without charging the card twice.</h3>
        <p class="lede">A process can die between two tool calls. When the run resumes, 10xGraph replays the interrupted step but checks a tool ledger first, so tools that already finished are skipped instead of executed again.</p>
    <div class="replay" role="group" aria-label="Replay example">
      <div class="lane">
        <div class="who">Run 1<small>thread order-1042</small></div>
        <div class="tc ran"><code>lookup_order</code><span>ran · recorded</span></div>
        <div class="tc ran"><code>charge_card</code><span>ran · recorded</span></div>
        <div class="tc kill"><code>send_receipt</code><span>process killed</span></div>
      </div>
      <div class="lane">
        <div class="who">Resume<small>same thread</small></div>
        <div class="tc skip"><code>lookup_order</code><span>skipped · in ledger</span></div>
        <div class="tc skip"><code>charge_card</code><span>skipped · in ledger</span></div>
        <div class="tc ran"><code>send_receipt</code><span>ran · recorded</span></div>
      </div>
      <div class="replay-foot">Requires a checkpointer. Ledger entries are keyed by the assistant message that issued the call plus the tool call id.</div>
    </div>
        <ul class="pts c1">
      <li class="item"><h4>Tool ledger</h4><p>Each completed tool call is recorded as soon as it returns. Keys include the issuing message, so models that reuse ids like <code>call_1</code> never collide across turns.</p></li>
      <li class="item"><h4>Versioned state writes</h4><p>Durable writes use an optimistic version check, so two runs on the same thread cannot overwrite each other. The Redis cache is version-guarded too.</p></li>
      <li class="item"><h4>Real timeouts</h4><p><code>node_timeout</code> and <code>tool_timeout</code> stop a hung tool from holding a worker forever.</p></li>
        </ul>
      </article>
      <article class="panel" id="step-4" aria-labelledby="p-data">
        <div class="panel-row"><span>Step 4 of 7</span></div>

        <h3 class="pt" id="p-data">Postgres and Redis by default. Your database if you prefer.</h3>
        <p class="lede">Active conversations need fast reads, history needs to be durable, memory needs search. 10xGraph ships a store for each, and every one of them can be replaced.</p>
        <ul class="pts c1">
      <li class="item"><h4>Hot state</h4><p>Active thread state is cached in Redis on every step and read first, so a busy thread does not hit the database. Valkey, Dragonfly and KeyDB work too.</p></li>
      <li class="item"><h4>Durable history</h4><p>Threads and messages in PostgreSQL with versioned writes, so two runs cannot overwrite each other. SQLite for local work.</p></li>
      <li class="item"><h4>Long-term memory</h4><p>pgvector in the same Postgres for vector, full-text or hybrid search, or Qdrant as a dedicated vector service.</p></li>
        </ul>
        <div class="byo">
          <h4>Bring your own database</h4>
          <p>Each storage layer is one interface. Implement <code>BaseCheckpointer</code> or <code>BaseStore</code> for the database you already run and pass it to <code>compile()</code>; point <code>cache_store</code> at a <code>BaseCacheStore</code> for shared server state. The API, auth, tenancy and jobs work the same on top.</p>
                <div class="code"><div class="cap"><span>graph.py</span><span>python</span></div><pre tabindex="0"><code><span class="k">from</span> storage.my_db <span class="k">import</span> MyCheckpointer, MyStore

app = graph.compile(
    checkpointer=MyCheckpointer(),
    store=MyStore(),
)</code></pre></div>
          <p><a class="more" href="/docs/server/bring-your-own-backend">Bring your own backend &rarr;</a></p>
        </div>
      </article>
      <article class="panel" id="step-5" aria-labelledby="p-jobs">
        <div class="panel-row"><span>Step 5 of 7</span></div>

        <h3 class="pt" id="p-jobs">Background jobs with the same identity and rules</h3>
        <p class="lede">Reports, ingestion and nightly cleanups run on a worker, not in the request. The worker loads your graph, storage and auth config the same way the API does.</p>
              <div class="code"><div class="cap"><span>tasks.py</span><span>python</span></div><pre tabindex="0"><code><span class="k">from</span> tenxgraph_api.jobs <span class="k">import</span> broker

<span class="k">@broker.task</span>(task_name=<span class="s">"make_report"</span>, http=<span class="k">True</span>)
<span class="k">async def</span> make_report(topic: str, config: dict) -&gt; dict:
    <span class="c"># config["user"] is the identity of the caller who queued it</span>
    ...</code></pre><div class="term"><span>$</span> 10xgraph worker</div><div class="term"><span>$</span> 10xgraph scheduler</div></div>
        <ul class="pts c1">
        <li class="item"><h4>Start from Python or over HTTP</h4><p>Queue a task in code or with <code>POST /v1/tasks/&#123;name&#125;</code>; read progress and cancel it.</p></li>
        <li class="item"><h4>Runs as the caller</h4><p>A task carries the identity of the user who queued it, so access rules still apply.</p></li>
        <li class="item"><h4>Cron and brokers</h4><p>Schedule with cron. Redis Streams, RabbitMQ or Kafka as the broker.</p></li>
        </ul>
        <p class="center-link"><a href="/docs/jobs">Background jobs &rarr;</a></p>
      </article>
      <article class="panel" id="step-6" aria-labelledby="p-obs">
        <div class="panel-row"><span>Step 6 of 7</span></div>

        <h3 class="pt" id="p-obs">Metrics, traces and an audit log you own</h3>
        <p class="lede">Your logs and telemetry go to your own stack. Nothing is sent to 10xScale.</p>
        <ul class="pts c2">
      <li class="item"><h4>Metrics</h4><p>Prometheus metrics for the API and the worker.</p></li>
      <li class="item"><h4>Traces</h4><p>OpenTelemetry traces to Phoenix, Logfire, LangSmith or any OTLP backend.</p></li>
      <li class="item"><h4>JSON logs</h4><p>One JSON object per line with a request id, ready for your log pipeline.</p></li>
      <li class="item"><h4>Audit log</h4><p>A line for every access, denial and change: who, which tenant, which resource, allowed or not. Never prompts or answers.</p></li>
        </ul>
            <div class="code audit"><div class="cap"><span>audit log</span><span>json</span></div><pre class="wrapline" tabindex="0"><code>&#123;<span class="s">"event"</span>: <span class="s">"access"</span>, <span class="s">"user_id"</span>: <span class="s">"u-42"</span>, <span class="s">"tenant"</span>: &#123;<span class="s">"org_id"</span>: <span class="s">"acme"</span>&#125;, <span class="s">"action"</span>: <span class="s">"threads:read"</span>, <span class="s">"resource"</span>: <span class="s">"thread/abc123"</span>, <span class="s">"result"</span>: <span class="s">"denied"</span>&#125;</code></pre></div>
        <p class="center-link"><a href="/docs/observability">Observability &rarr;</a></p>
      </article>
      <article class="panel" id="step-7" aria-labelledby="cli-path">
        <div class="panel-row"><span>Step 7 of 7</span></div>
        <p class="leadin"><code>10xgraph build</code> writes the Dockerfile, docker-compose.yml and a Kubernetes manifest, with liveness and readiness probes.</p>
        <h3 class="pt" id="cli-path">Three commands from empty folder to running service</h3>
        <ol class="cmds">
      <li class="item"><span class="step-n">01</span><div class="tb"><span>$</span>10xgraph init</div><p>Scaffold a project. Three questions: name, template, provider. The Production template turns on auth, rate limits and token revocation.</p></li>
      <li class="item"><span class="step-n">02</span><div class="tb"><span>$</span>10xgraph dev</div><p>Start the API server and open the playground. Chat with your agent, inspect threads and runs.</p></li>
      <li class="item"><span class="step-n">03</span><div class="tb"><span>$</span>10xgraph build</div><p>Write the Dockerfile, and with flags docker-compose.yml and a Kubernetes manifest.</p></li>
        </ol>
      </article>
      </div>
    </div>
        <p class="center-link mid"><a href="/docs/production">See the platform overview &rarr;</a></p>
